{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Defender Watch",
  "version": "0.1.0",
  "identifier": "local.defender-watch",
  "build": { "frontendDist": "../web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "Defender Watch",
      "width": 1200,
      "height": 860,
      "minWidth": 900,
      "minHeight": 620,
      "visible": false
    }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false }
}
